# ===================== 智能邮件处理系统 · 环境变量示例 =====================
# 复制本文件为 .env 并按需填写。所有敏感信息仅从此处读取，代码中绝不硬编码。

# ---------- 邮箱 (IMAP) ----------
# QQ 邮箱：服务器 imap.qq.com，端口 993。需先在 QQ 邮箱设置中开启 IMAP 服务，
#          密码处填写的是「授权码」，不是登录密码。
# Gmail：  服务器 imap.gmail.com，端口 993。需开启两步验证并生成「应用专用密码」。
IMAP_SERVER=
IMAP_PORT=993
IMAP_EMAIL=
IMAP_PASSWORD=
# 是否使用 SSL 连接（IMAPS）
IMAP_USE_SSL=true

# 每次拉取的未读邮件数量上限
EMAIL_FETCH_LIMIT=20
# 邮件正文预览长度（字符数，控制传给 LLM 的 token 消耗）
EMAIL_BODY_PREVIEW_LEN=300

# ---------- LLM 分类 (litellm) ----------
# mock：不调用真实模型，使用关键词规则分类（演示用，推荐先这样跑通）
# real：调用真实模型，需同时填写 LLM_MODEL 与 LLM_API_KEY
LLM_MODE=mock

# litellm 模型名，格式 provider/model，例如：
#   deepseek/deepseek-chat    DeepSeek
#   openai/gpt-4o-mini        OpenAI 兼容服务
LLM_MODEL=deepseek/deepseek-chat
LLM_API_KEY=
# 兼容 OpenAI 协议的网关地址（如 OneAPI / Ollama / 私有网关），留空则走官方接口
LLM_BASE_URL=

# ---------- 安全网关 ----------
# write_external（外部写，如发送邮件）类工具是否启用。
# 默认 false = 禁用（对应需求文档的安全红线：AI 绝不自动外发）
ENABLE_WRITE_EXTERNAL=false
